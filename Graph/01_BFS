class Solution {
  public:
  
  void bfs(vector<vector<int>>& adj, vector<bool>& visited, int node, vector<int>& res){
      
      queue<int> q;
      
      q.push(node);
      visited[node] = true;
      
      while(!q.empty()){
            node = q.front();
            q.pop();
            
            res.push_back(node);
            
            for(int next: adj[node]){
                if(!visited[next]){
                    visited[next] = true;
                    q.push(next);
                }
            }
      }
  }
    vector<int> bfs(vector<vector<int>>& adj) {
        
        int V = adj.size();
        vector<bool> visited(V,false);
        vector<int> res;
        bfs(adj, visited, 0, res);
        return res;
        
    }
};
